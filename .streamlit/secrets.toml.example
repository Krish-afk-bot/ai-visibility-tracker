# Streamlit Cloud Secrets Configuration
# Paste these key-value pairs into Streamlit Cloud -> App Settings -> Secrets
# Values must be quoted strings. Every comment line must start with #

# 1. OpenRouter (Optional)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY = "your_openrouter_api_key_here"
# Comma-separated list of live free models from openrouter.ai/models?max_price=0
OPENROUTER_MODELS = "meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free"
OPENROUTER_RPM = "20"

# 2. Groq Cloud (Optional)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY = "your_groq_api_key_here"
# Comma-separated list of Groq models from console.groq.com/docs/models
GROQ_MODELS = "llama-3.1-8b-instant,mixtral-8x7b-32768"
GROQ_RPM = "30"

# 3. Gemini (Optional, via OpenAI-compatible endpoint)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your_gemini_api_key_here"
# Comma-separated list of Gemini models from Google AI Studio
GEMINI_MODELS = "gemini-1.5-flash,gemini-2.0-flash"
GEMINI_RPM = "15"

# 4. Analyzer Model (REQUIRED)
# Dedicated model used to grade sentiment and extract competitors across all tested models.
# Must NOT be in your selected test models (a model must never grade its own answer).
# Format: provider:model-id
ANALYZER_MODEL = "gemini:gemini-1.5-flash"

# 5. Access Control & Quota (Optional)
# If APP_PASSWORD is set, real scans require entering it once per session
# APP_PASSWORD = "your_password_here"
# Cap on real LLM calls per session when APP_PASSWORD is unset (default 30)
MAX_CALLS_PER_SESSION = "30"
