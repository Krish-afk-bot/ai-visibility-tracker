# ==============================================================================
# AI Visibility Tracker - Environment Configuration
# ==============================================================================
# IMPORTANT:
# Free-tier model availability and rate limits change frequently.
# Do NOT rely on model IDs to exist permanently.
# Copy current, live model IDs directly from each provider's console/directory:
# - OpenRouter (filter by free): https://openrouter.ai/models?max_price=0
# - Groq Cloud Console: https://console.groq.com/docs/models
# - Google AI Studio (Gemini): https://aistudio.google.com/app/apikey
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenRouter Configuration (Optional)
# ------------------------------------------------------------------------------
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated list of free OpenRouter models (must end in :free)
# Copy active free IDs from https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_TITLE=AI Visibility Tracker
OPENROUTER_RPM=20

# ------------------------------------------------------------------------------
# 2. Groq Cloud Configuration (Optional)
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=
# Comma-separated list of Groq models from console.groq.com/docs/models
GROQ_MODELS=
GROQ_RPM=30

# ------------------------------------------------------------------------------
# 3. Gemini Configuration (Optional, via OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Comma-separated list of Gemini models from Google AI Studio
GEMINI_MODELS=
GEMINI_RPM=15

# ------------------------------------------------------------------------------
# 4. Analyzer Model (REQUIRED)
# ------------------------------------------------------------------------------
# Dedicated model used to grade sentiment and extract competitors across all tested models.
# Must NOT be in your selected test models (a model must never grade its own answer).
# Format: provider:model-id (e.g. groq:<model-id> or gemini:<model-id>)
ANALYZER_MODEL=

# ------------------------------------------------------------------------------
# 5. Database Configuration (Optional)
# ------------------------------------------------------------------------------
# By default, uses local SQLite database file (visibility_tracker.db).
# On Streamlit Cloud or GitHub Actions, set DATABASE_URL to a persistent database:
# - SQLite URI: sqlite:///path/to/visibility_tracker.db
# - Hosted Free Options: Turso (libSQL) or Supabase (PostgreSQL)
# DATABASE_URL=sqlite:///visibility_tracker.db
# DB_PATH=visibility_tracker.db

